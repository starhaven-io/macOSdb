{
  "name": "macosdb.com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:headers": "node scripts/check-security-headers.mjs",
    "audit": "npm audit --audit-level=moderate",
    "prebuild": "node scripts/check-security-headers.mjs",
    "build": "astro build && node scripts/check-built-csp.mjs && node scripts/check-built-api.mjs",
    "preview": "astro preview",
    "test": "node --test 'test/*.test.ts'",
    "astro": "astro",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry": "npm run deploy -- --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/compiler-rs": "^0.4.0",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.2.9",
    "astro-pagefind": "^2.0.1",
    "satori": "^0.33.4",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "4.127.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  },
  "overrides": {
    "fflate": "0.7.5",
    "nanoid": "3.3.18"
  }
}
